# Copy to /etc/proxy-control/version-agent.env and keep root:root 0600.
PROXY_CONTROL_VERSION_SOCKET=/run/proxy-control/version-agent.sock
# The panel container uses numeric GID 10001 for this socket.
PROXY_CONTROL_VERSION_SOCKET_GID=10001
PROXY_CONTROL_VERSION_CATALOG=/etc/proxy-control/versions.json
PROXY_CONTROL_VERSION_STATE=/var/lib/proxy-control/version-agent/state.json
PROXY_CONTROL_COMPOSE_DIR=/opt/mtproxy-shared443
# Keep the complete production overlay set. Do not omit active overlays.
PROXY_CONTROL_COMPOSE_FILES=compose.yaml:compose.naive.yaml:compose.mieru.yaml
PROXY_CONTROL_BINARY_PATHS=naive=/usr/local/bin/caddy,mita=/usr/bin/mita
PROXY_CONTROL_SERVICE_NAMES=naive=caddy-naive,mita=mita
PROXY_CONTROL_CHECKERS=naive=/usr/local/libexec/check-naive-caddy-build
PROXY_CONTROL_CADDYFILES=naive=/var/lib/naive-manager/Caddyfile
PROXY_CONTROL_VERSION_HEALTH_TIMEOUT=90
