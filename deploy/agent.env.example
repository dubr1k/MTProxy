# Copy to /etc/mtproxy-agent/agent.env (root:mtproxy-agent 0640).
FLEET_NODE_ID=example-node-02
FLEET_CENTRAL_URL=https://fleet.example.com:8790
FLEET_CLIENT_CERT=/etc/mtproxy-agent/example-node-02.crt
FLEET_CLIENT_KEY=/etc/mtproxy-agent/example-node-02.key
# Omit FLEET_SERVER_CA in production to require the OS WebPKI trust store.
TELEMT_API_URL=http://127.0.0.1:9091
TELEMT_API_TOKEN_FILE=/etc/mtproxy-agent/telemt-api-token
FLEET_JOURNAL=/var/lib/mtproxy-agent/journal.sqlite3
