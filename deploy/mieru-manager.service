[Unit]
Description=Proxy Control transactional Mieru manager
After=mita.service
Requires=mita.service

[Service]
Type=simple
User=10005
Group=10005
SupplementaryGroups=mita
EnvironmentFile=/etc/mieru-manager/manager.env
ExecStart=/opt/proxy-control/venv/bin/python -m mieru_manager
Restart=on-failure
RestartSec=2s
RuntimeDirectory=mieru-manager
RuntimeDirectoryMode=0770
StateDirectory=mieru-manager
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
TemporaryFileSystem=/tmp:rw,nosuid,nodev,noexec,size=8M,mode=0700
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadOnlyPaths=/usr/bin/mita /var/run/mita
ReadWritePaths=/var/lib/mieru-manager /run/mieru-manager

[Install]
WantedBy=multi-user.target
