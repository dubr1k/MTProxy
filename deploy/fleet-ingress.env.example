PANEL_DATABASE=/var/lib/mtproxy-panel/panel.sqlite3
FLEET_LISTEN_HOST=0.0.0.0
FLEET_LISTEN_PORT=8790
# Root-only Certbot sources for the exact FLEET_CENTRAL_URL hostname.  The
# systemd unit stages private copies into its 0700 RuntimeDirectory at every
# start; keep the Certbot private key root-owned and mode 0600.
FLEET_SERVER_CERT_SOURCE=/etc/letsencrypt/live/fleet.example.com/fullchain.pem
FLEET_SERVER_KEY_SOURCE=/etc/letsencrypt/live/fleet.example.com/privkey.pem
FLEET_SERVER_CERT=/run/mtproxy-fleet-ingress/server.crt
FLEET_SERVER_KEY=/run/mtproxy-fleet-ingress/server.key
# Public half of the private client CA; never deploy ca.key to this service.
FLEET_CLIENT_CA=/etc/mtproxy-panel/fleet-client-ca.crt
FLEET_POLL_SECONDS=20
FLEET_REQUEST_TIMEOUT=10
FLEET_BODY_LIMIT=16384
FLEET_RATE_PER_MINUTE=120
