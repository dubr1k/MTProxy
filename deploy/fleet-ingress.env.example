PANEL_DATABASE=/var/lib/mtproxy-panel/panel.sqlite3
FLEET_LISTEN_HOST=0.0.0.0
FLEET_LISTEN_PORT=8790
# WebPKI certificate for the exact FLEET_CENTRAL_URL hostname.
FLEET_SERVER_CERT=/etc/letsencrypt/live/fleet.example.com/fullchain.pem
FLEET_SERVER_KEY=/etc/letsencrypt/live/fleet.example.com/privkey.pem
# Public half of the private client CA; never deploy ca.key to this service.
FLEET_CLIENT_CA=/etc/mtproxy-panel/fleet-client-ca.crt
FLEET_POLL_SECONDS=20
FLEET_REQUEST_TIMEOUT=10
FLEET_BODY_LIMIT=16384
FLEET_RATE_PER_MINUTE=120
