[Unit]
Description=NaiveProxy Caddy (unprivileged, pinned build)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=naive-caddy
Group=naive-accounting
ExecStartPre=/usr/local/libexec/check-naive-caddy-build
RuntimeDirectory=caddy-naive
RuntimeDirectoryMode=0700
ExecStartPre=+/usr/bin/install -o 10003 -g 10004 -m 0400 /var/lib/naive-manager/Caddyfile /run/caddy-naive/Caddyfile
ExecStart=/usr/local/bin/caddy run --environ --config /run/caddy-naive/Caddyfile
ExecReload=+/usr/bin/install -o 10003 -g 10004 -m 0400 /var/lib/naive-manager/Caddyfile /run/caddy-naive/Caddyfile
ExecReload=/usr/local/bin/caddy reload --config /run/caddy-naive/Caddyfile --force
TimeoutStopSec=5s
LimitNOFILE=1048576
Restart=on-failure
RestartSec=2s
UMask=0027
NoNewPrivileges=true
ProtectProc=invisible
ProcSubset=pid
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
InaccessiblePaths=/var/lib/naive-manager
ReadWritePaths=/var/log/naive-proxy /run/caddy-naive

[Install]
WantedBy=multi-user.target
