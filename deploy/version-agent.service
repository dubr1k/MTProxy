[Unit]
Description=Proxy Control privileged version update agent
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=-/etc/proxy-control/version-agent.env
WorkingDirectory=/opt/proxy-control
ExecStartPre=/usr/bin/chown root:10001 /run/proxy-control
ExecStartPre=/usr/bin/install -d -o root -g root -m 0750 /opt/mtproxy-shared443/version-overrides
ExecStart=/usr/bin/python3 -m version_agent.server
Restart=on-failure
RestartSec=3s
StateDirectory=proxy-control/version-agent
StateDirectoryMode=0700
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
# Staging and atomic replacement happen in the target's directory, so the
# directories must be writable; naming the binaries alone leaves them read-only.
ReadWritePaths=/run/proxy-control /var/lib/proxy-control /etc/proxy-control /opt/mtproxy-shared443/version-overrides /usr/local/bin /usr/bin

[Install]
WantedBy=multi-user.target
